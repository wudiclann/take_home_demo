# Python
__pycache__/
*.py[cod]
backend/venv/
*.egg-info/

# Environment secrets
.env
!.env.example

# Backend data (SQLite db, Chroma persistence, uploaded PDFs, generated audio)
backend/data/*
!backend/data/.gitkeep
!backend/data/chroma/
backend/data/chroma/*
!backend/data/chroma/.gitkeep
!backend/data/documents/
backend/data/documents/*
!backend/data/documents/.gitkeep

# Backend static (built frontend copy, regenerated by the frontend build step)
backend/static/*
!backend/static/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/

# OS
.DS_Store

# Editors
.vscode/
.idea/
