# OpenAI API key -- used for embeddings, chat completions, Whisper (ASR), and TTS
OPENAI_API_KEY=

# TTS voice/speed -- both editable from the app's Settings page; these are just the
# defaults if unset. Voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage,
# shimmer, verse. Speed: 0.5-2.0 (1.0 = OpenAI's normal pace).
TTS_VOICE=alloy
TTS_SPEED=1.25
